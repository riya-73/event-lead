# Neon PostgreSQL pooled connection URL (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Optional unpooled/direct URL, useful for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# AI provider selection: gemini (preferred) or openai
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional fallback when Gemini is not configured
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional for OpenAI-compatible providers; leave blank for OpenAI's default API
OPENAI_BASE_URL=""
